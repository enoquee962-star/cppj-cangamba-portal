<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - CPPJ Cangamba</title>
    <!-- FontAwesome para ícones -->
    <link rel="stylesheet" href="https://cloudflare.com">
    <style>
        :root {
            --azul-master: #0f172a;
            --azul-claro: #1e293b;
            --dourado: #fbbf24;
            --branco: #ffffff;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--azul-master);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            color: var(--branco);
        }

        .login-card {
            background: var(--azul-claro);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            width: 100%;
            max-width: 400px;
            text-align: center;
            border: 1px solid rgba(251, 191, 36, 0.2);
        }

        .logo-login {
            width: 80px;
            margin-bottom: 20px;
            filter: drop-shadow(0 0 10px rgba(251, 191, 36, 0.3));
        }

        h2 {
            margin-bottom: 10px;
            color: var(--dourado);
            font-size: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        p {
            font-size: 0.85rem;
            color: #94a3b8;
            margin-bottom: 30px;
        }

        .input-group {
            position: relative;
            margin-bottom: 20px;
            text-align: left;
        }

        .input-group i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--dourado);
        }

        .input-group input {
            width: 100%;
            padding: 12px 15px 12px 45px;
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 10px;
            color: white;
            box-sizing: border-box;
            outline: none;
            transition: 0.3s;
        }

        .input-group input:focus {
            border-color: var(--dourado);
            box-shadow: 0 0 8px rgba(251, 191, 36, 0.2);
        }

        .btn-entrar {
            width: 100%;
            padding: 12px;
            background: var(--dourado);
            border: none;
            border-radius: 10px;
            color: var(--azul-master);
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;
            transition: 0.3s;
            text-transform: uppercase;
        }

        .btn-entrar:hover {
            background: #f59e0b;
            transform: translateY(-2px);
        }

        .link-voltar {
            display: block;
            margin-top: 20px;
            color: #64748b;
            text-decoration: none;
            font-size: 0.8rem;
        }

        .link-voltar:hover {
            color: var(--dourado);
        }
    </style>
</head>
<body>

    <div class="login-card">
        <img src="/logo-cppj.png" alt="Logo CPPJ" class="logo-login" onerror="this.src='https://placeholder.com'">
        
        <h2>Acesso Restrito</h2>
        <p>Painel de Gestão - Cangamba</p>

        <!-- AQUI: action="/auth" para ligar ao teu server.js -->
        <form action="/auth" method="POST">
            <div class="input-group">
                <i class="fas fa-user"></i>
                <input type="text" name="usuario" placeholder="Nome de Utilizador" required>
            </div>

            <div class="input-group">
                <i class="fas fa-lock"></i>
                <input type="password" name="senha" placeholder="Palavra-passe" required>
            </div>

            <button type="submit" class="btn-entrar">
                <i class="fas fa-sign-in-alt"></i> Entrar no Sistema
            </button>
        </form>

        <a href="/" class="link-voltar">
            <i class="fas fa-arrow-left"></i> Voltar ao Portal Público
        </a>
    </div>

</body>
</html>
